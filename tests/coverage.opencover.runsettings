<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    OpenCover coverage collection for the SonarCloud workflow
    (.github/workflows/sonarcloud.yml) and the local preview tool
    (scripts/sonar/preview.ps1).

    The canonical CI coverage artifact is the Cobertura report produced by
    tests/coverage.runsettings instead.

    The test assemblies stay out so the Sonar coverage metric describes the
    shipped libraries only.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage"
                     uri="datacollector://coverlet/XPlatCodeCoverage">
        <Configuration>
          <Format>opencover</Format>
          <Exclude>[*]*.Tests*</Exclude>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputPath>..\..\artifacts\</OutputPath>
        <Version>1.5.0</Version>
        <Description>
            Query Microsoft.Extensions.FileProviders sources with Jeninnet.FileQuery: physical, embedded, and in-memory providers share the same matching, filtering, and metadata pipeline.
        </Description>
        <PackageTags>filequery;fileprovider;aspnetcore;embedded-files;in-memory;glob;gitignore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.FileQuery\Jeninnet.FileQuery.csproj" />
    </ItemGroup>

</Project>

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Jeninnet Repository Cleanup Configuration",
    "type": "object",

    "required": [
        "version",
        "directories"
    ],

    "properties": {
        "version": {
            "type": "integer",
            "description": "Configuration version."
        },

        "directories": {
            "type": "object",

            "required": [
                "include",
                "exclude"
            ],

            "properties": {

                "include": {
                    "type": "array",
                    "description": "Directory patterns to remove.",
                    "items": {
                        "type": "string"
                    }
                },

                "exclude": {
                    "type": "array",
                    "description": "Directory names excluded from cleanup.",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}

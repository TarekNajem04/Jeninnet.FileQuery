{
    "$schema": "./coverage.schema.json",

    "coverage": {
        "resultsDirectory": "TestResults",
        "reportDirectory": "artifacts/coverage",

        "reportTypes": [
            "Html",
            "HtmlSummary",
            "TextSummary"
        ]
    },

    "test": {
        "command": "dotnet test",
        "arguments": [
            "--collect:XPlat Code Coverage"
        ]
    },

    "reportGenerator": {
        "toolCommand": "reportgenerator",

        "assemblyFilters": [
            "+Jeninnet.FileQuery*",
            "+Jeninnet.FileQuery.CommandLine*",
            "+Jeninnet.FileQuery.DependencyInjection*",
            "+Jeninnet.FileQuery.Tool*",
            "+Jeninnet.FileQuery.Tooling*"
        ]
    },

    "behavior": {
        "openReport": true
    }
}
